/* 加载动画 */
.loading-area.data-v-7b8d50ad {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.loading-content.data-v-7b8d50ad {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 60rpx;
  text-align: center;
}
.loading-spinner.data-v-7b8d50ad {
  width: 60rpx;
  height: 60rpx;
  margin: 0 auto 30rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #FF8C42;
  border-radius: 50%;
  animation: spin-7b8d50ad 1s linear infinite;
}
@keyframes spin-7b8d50ad {
0% { transform: rotate(0deg);
}
100% { transform: rotate(360deg);
}
}
.loading-text.data-v-7b8d50ad {
  display: block;
  font-size: 32rpx;
  color: #5C4033;
  margin-bottom: 10rpx;
}
.loading-desc.data-v-7b8d50ad {
  display: block;
  font-size: 24rpx;
  color: #B8956A;
}

/* ========== 小鸡加载动画 ========== */
.chicken-loader.data-v-7b8d50ad {
  width: 120rpx;
  height: 120rpx;
  position: relative;
  margin: 0 auto 30rpx;
}
.cl-body.data-v-7b8d50ad {
  width: 70rpx;
  height: 65rpx;
  background: linear-gradient(135deg, #FFD93D 0%, #FFB347 100%);
  border-radius: 50% 50% 45% 45%;
  position: absolute;
  top: 30rpx;
  left: 25rpx;
  animation: loaderBounce-7b8d50ad 0.6s ease-in-out infinite;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 66, 0.3);
}
.cl-body.data-v-7b8d50ad::before {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 18rpx solid #FF6B35;
}
.cl-eye.data-v-7b8d50ad {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  background: #333;
  border-radius: 50%;
  top: 48rpx;
  z-index: 2;
  animation: chickenBlink 3s ease-in-out infinite;
}
.cl-eye.le.data-v-7b8d50ad { left: 38rpx;
}
.cl-eye.ri.data-v-7b8d50ad { right: 38rpx;
}
.cl-wing.data-v-7b8d50ad {
  position: absolute;
  width: 22rpx;
  height: 26rpx;
  background: #FFB347;
  border-radius: 50%;
  top: 50rpx;
  z-index: 1;
}
.cl-wing.lw.data-v-7b8d50ad {
  left: 18rpx;
  animation: wingFlapLeft 0.6s ease-in-out infinite;
}
.cl-wing.rw.data-v-7b8d50ad {
  right: 18rpx;
  animation: wingFlapRight 0.6s ease-in-out infinite;
}
.cl-dust.data-v-7b8d50ad {
  position: absolute;
  bottom: 15rpx;
  background: rgba(255, 140, 66, 0.25);
  border-radius: 50%;
  animation: dustFade-7b8d50ad 0.8s ease-out infinite;
}
.cl-dust.d1.data-v-7b8d50ad { left: 15rpx; width: 10rpx; height: 10rpx; animation-delay: 0s;
}
.cl-dust.d2.data-v-7b8d50ad { left: 35rpx; width: 8rpx; height: 8rpx; animation-delay: 0.2s;
}
.cl-dust.d3.data-v-7b8d50ad { left: 55rpx; width: 12rpx; height: 12rpx; animation-delay: 0.4s;
}
@keyframes loaderBounce-7b8d50ad {
0%, 100% { transform: translateY(0);
}
50% { transform: translateY(-15rpx);
}
}
@keyframes dustFade-7b8d50ad {
0% { opacity: 0.6; transform: translateX(0) scale(1);
}
100% { opacity: 0; transform: translateX(-20rpx) scale(0.5);
}
}
